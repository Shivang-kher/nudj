# Backend base URL. Localhost works in the simulator; a physical device needs
# your machine's LAN IP, or the deployed host once M1 Task 0 is done.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth only — the app never queries Supabase tables directly.
# Both of these are PUBLIC: EXPO_PUBLIC_* is compiled into the app bundle,
# so treat anything with that prefix as readable by anyone with the .apk/.ipa.
# Settings -> API Keys -> Publishable key (sb_publishable_...)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
