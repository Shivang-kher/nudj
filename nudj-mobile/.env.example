# Base URL of the Nudj backend.
#   iOS Simulator      http://localhost:8000
#   Android emulator   http://10.0.2.2:8000
#   Physical phone     http://<your-mac-lan-ip>:8000   (ipconfig getifaddr en0)
#   Any network        your ngrok / cloudflared https tunnel
EXPO_PUBLIC_API_URL=http://localhost:8000
