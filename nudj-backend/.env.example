# WhatsApp Cloud API
WHATSAPP_TOKEN=           # Meta permanent token
WHATSAPP_PHONE_ID=        # Phone number ID from Meta dashboard
WHATSAPP_VERIFY_TOKEN=    # Self-chosen secret string for webhook verification

# Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain/oauth/callback

# OpenRouter (free tier — openrouter.ai, no per-request token cap)
OPENROUTER_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=     # Service role key (bypasses RLS for backend)

# Security
ENCRYPTION_KEY=           # 32-byte hex key for AES-256-GCM token encryption

# App
BASE_URL=https://yourdomain
PORT=8000
